# ==============================================================================
# Agri-Aqua Network — Production Environment Configuration Template
# Production Subdomain Target: https://app.ayangiri.com/
# NOTE: Never commit real credentials or secrets to version control.
# ==============================================================================

# Application Runtime
NODE_ENV=production
PORT=3000
APP_VERSION=1.0.0
NEXT_TELEMETRY_DISABLED=1

# Canonical Production URL
APP_URL=https://app.ayangiri.com
# Backward-compatibility alias for URL
NEXTAUTH_URL=https://app.ayangiri.com

# Cryptographic JWT Session Secret (Custom Jose/Bcrypt Auth)
# Generate a secure 64-char string via: openssl rand -base64 32
AUTH_SECRET=replace_with_a_64_character_crypto_secure_secret_in_production
# Backward-compatibility alias for Secret
NEXTAUTH_SECRET=replace_with_a_64_character_crypto_secure_secret_in_production

# PostgreSQL Database Connections (Prisma ORM)
# 1. Connection Pooler URL (e.g. Supabase, Neon, RDS with PgBouncer)
DATABASE_URL="postgresql://postgres:secure_password@pgbouncer.internal:6543/agri_aqua_prod?pgbouncer=true&connection_limit=20"
# 2. Direct Database URL for Prisma migrations (port 5432)
DIRECT_DATABASE_URL="postgresql://postgres:secure_password@postgres.internal:5432/agri_aqua_prod"

# Distributed Redis / Upstash (Optional: Required for Multi-Instance Pub/Sub & Rate Limiting)
# If single-instance deployment, in-memory is used.
REDIS_URL="redis://default:secure_token@redis-host:6379"

# S3 / Cloudflare R2 Object Storage
OBJECT_STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_ACCESS_KEY="your_production_storage_access_key"
OBJECT_STORAGE_SECRET_KEY="your_production_storage_secret_key"
OBJECT_STORAGE_BUCKET="agri-aqua-public-media"
OBJECT_STORAGE_PRIVATE_BUCKET="agri-aqua-vault-documents"
NEXT_PUBLIC_CDN_URL="https://assets.agriaqua.dev"

# Rate Limiting Policies
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
