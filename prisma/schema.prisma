// Agri-Aqua Network - Prisma Schema
// Phase 2: Authentication, Sessions & RBAC Engine

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Baseline system health model for connection probing
model SystemHealth {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  checkedAt DateTime @default(now())

  @@map("system_health")
}

// User model for Authentication & RBAC Engine
model User {
  id           String     @id @default(uuid())
  fullName     String
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  role         UserRole   @default(FARMER)
  status       UserStatus @default(PENDING_VERIFICATION)
  tokenVersion Int        @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
  @@map("users")
}

enum UserRole {
  FARMER
  BUYER
  AGENT
  SERVICE_PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
}