# ==============================================================================
# Agri-Aqua Network - Production Environment Configuration Template
# Phase 16: Production Go-Live & Scaling Infrastructure
# NOTE: Never commit real credentials or secrets to version control.
# ==============================================================================

# Application Metadata & Runtime
NODE_ENV=production
PORT=3000
APP_VERSION=1.0.0
NEXT_TELEMETRY_DISABLED=1

# Custom Domain & App URLs
APP_URL=https://app.ayangiri.com
NEXTAUTH_URL=https://app.ayangiri.com

# Cryptographic Authentication Secret (Generate via: openssl rand -base64 32)
NEXTAUTH_SECRET=replace_with_a_64_character_crypto_secure_secret_in_production

# PostgreSQL Database Connections (Prisma ORM)
# 1. Connection Pooler URL (e.g. PgBouncer / Supavisor on port 6543)
DATABASE_URL="postgresql://postgres:secure_password@pgbouncer.internal:6543/agri_aqua_db?pgbouncer=true&connection_limit=20"
# 2. Direct Database URL for Prisma migrations (port 5432)
DIRECT_DATABASE_URL="postgresql://postgres:secure_password@postgres.internal:5432/agri_aqua_db"

# Distributed Redis / Upstash (Required for Multi-Instance Pub/Sub & Rate Limiting)
REDIS_URL="redis://default:secure_redis_token@redis-cluster.internal:6379"

# S3 / Cloudflare R2 Object Storage
OBJECT_STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_ACCESS_KEY="your_production_s3_access_key"
OBJECT_STORAGE_SECRET_KEY="your_production_s3_secret_key"
OBJECT_STORAGE_BUCKET="agri-aqua-public-media"
OBJECT_STORAGE_PRIVATE_BUCKET="agri-aqua-vault-documents"
NEXT_PUBLIC_CDN_URL="https://assets.agriaqua.net"

# Error Monitoring & Distributed Observability (Optional: Sentry)
# SENTRY_DSN="https://publicKey@o0.ingest.sentry.io/0"
# NEXT_PUBLIC_SENTRY_DSN="https://publicKey@o0.ingest.sentry.io/0"

# Rate Limiting Policies
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
