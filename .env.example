# ==============================================================================
# Agri-Aqua Network - Environment Configuration Template
# Phase 1: Project Foundation
# NOTE: Never commit real credentials or secrets to version control.
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Application Port
PORT=3000

# Base URL for Next.js App
NEXTAUTH_URL=http://localhost:3000

# NextAuth Cryptographic Secret (Generate via: openssl rand -base64 32)
NEXTAUTH_SECRET=replace_with_a_secure_random_base64_string_in_production

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agri_aqua_db?schema=public"

# S3 / Cloudflare R2 / MinIO Object Storage
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY=your_storage_access_key
OBJECT_STORAGE_SECRET_KEY=your_storage_secret_key
OBJECT_STORAGE_BUCKET=agri-aqua-public
OBJECT_STORAGE_PRIVATE_BUCKET=agri-aqua-vault

# Rate Limiting & Session Configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
